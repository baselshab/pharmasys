# Frontend Environment Variables
# Copy this file to .env and customize for your environment

# API Configuration
VITE_API_URL=http://localhost:4000/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=PharmaSys
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false

# Sync Configuration
VITE_SYNC_BATCH_SIZE=10
VITE_SYNC_RETRY_ATTEMPTS=3
VITE_SYNC_RETRY_DELAY=1000

# UI Configuration
VITE_THEME=light  # light or dark
VITE_LANGUAGE=en  # en or ar
VITE_TOAST_DURATION=5000

# Debug Mode
VITE_DEBUG=true
VITE_ENABLE_LOGGING=false
VITE_LOG_LEVEL=info  # debug, info, warn, error

# Storage Configuration
VITE_USE_LOCAL_STORAGE=true
VITE_USE_INDEXED_DB=false
VITE_STORAGE_SIZE_LIMIT=10485760  # 10MB in bytes

# Authentication
VITE_AUTH_TOKEN_KEY=pharmasys_auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=pharmasys_refresh_token
VITE_AUTH_EXPIRY_KEY=pharmasys_auth_expiry

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=

# API Endpoints (alternative to VITE_API_URL)
VITE_PRODUCTS_API=http://localhost:4000/api/products
VITE_SALES_API=http://localhost:4000/api/sales
VITE_CUSTOMERS_API=http://localhost:4000/api/customers
VITE_SUPPLIERS_API=http://localhost:4000/api/suppliers
VITE_REPORTS_API=http://localhost:4000/api/reports

# Sync Queue Configuration
VITE_SYNC_QUEUE_NAME=pharmasys_sync_queue
VITE_SYNC_NOTIFICATION_ENABLED=true
VITE_SYNC_AUTO_RETRY=true

# Performance
VITE_ENABLE_SOURCE_MAP=true
VITE_BUILD_SOURCEMAP=false

# Security
VITE_APP_SECURE_COOKIE=false  # Set to true in production
VITE_ENABLE_CSP=false
VITE_CSP_POLICY=

# Database (for local SQLite storage)
VITE_DATABASE_NAME=pharmasys
VITE_DATABASE_VERSION=1

# Barcode Scanner
VITE_BARCODE_SCANNER_ENABLED=true
VITE_BARCODE_TIMEOUT=1000

# Offline Fallback
VITE_OFFLINE_FALLBACK_ENABLED=true
VITE_OFFLINE_CACHE_EXPIRY=604800000  # 7 days in milliseconds

# Download/Export Configuration
VITE_MAX_EXPORT_SIZE=52428800  # 50MB
VITE_EXPORT_FORMAT=csv,excel,pdf

# Report Configuration
VITE_REPORT_REFRESH_INTERVAL=300000  # 5 minutes
VITE_REPORT_PAGE_SIZE=50

# POS Configuration
VITE_POS_RECEIPT_WIDTH=80  # mm
VITE_POS_PRINT_AFTER_SAVE=false
VITE_POS_ITEM_SEARCH_DEBOUNCE=300  # milliseconds

# Dashboard Configuration
VITE_DASHBOARD_REFRESH_INTERVAL=30000  # 30 seconds
VITE_DASHBOARD_WIDGET_COUNT=8

# Multi-language Support
VITE_SUPPORTED_LANGUAGES=en,ar
VITE_FALLBACK_LANGUAGE=en

# Branch/Pharmacy Configuration
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_TIMEZONE=UTC
VITE_DATE_FORMAT=YYYY-MM-DD
VITE_TIME_FORMAT=HH:mm:ss

# Security Headers
VITE_X_FRAME_OPTIONS=SAMEORIGIN
VITE_X_CONTENT_TYPE_OPTIONS=nosniff
VITE_X_XSS_PROTECTION=1; mode=block

# Development Tools
VITE_ENABLE_REACT_DEVTOOLS=true
VITE_ENABLE_REDUX_DEVTOOLS=false

# API Rate Limiting (client-side)
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_WINDOW=60000  # 1 minute
VITE_RATE_LIMIT_MAX_REQUESTS=30

# Session Configuration
VITE_SESSION_TIMEOUT=3600000  # 1 hour
VITE_SESSION_WARNING_TIME=300000  # 5 minutes before timeout

# File Upload
VITE_MAX_FILE_SIZE=104857600  # 100MB
VITE_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,xlsx,xls,csv

# Notification
VITE_NOTIFICATION_POSITION=bottom-right  # top-right, top-center, bottom-right, etc.
VITE_NOTIFICATION_MAX_ITEMS=5

# Experimental Features (set to false by default)
VITE_EXPERIMENTAL_VOICE_SEARCH=false
VITE_EXPERIMENTAL_AI_SUGGESTIONS=false
VITE_EXPERIMENTAL_REAL_TIME_SYNC=false
